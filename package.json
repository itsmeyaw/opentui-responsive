{
  "name": "@itsmeyaw/opentui-responsive",
  "version": "0.1.0",
  "description": "Typed responsive breakpoints for OpenTUI.",
  "license": "MIT",
  "repository": "github:itsmeyaw/opentui-responsive",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js",
      "default": "./dist/solid/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "accept:node": "node scripts/accept-node-core.mjs && node --experimental-ffi scripts/accept-node-solid.mjs",
    "build": "bun build.ts && tsc -p tsconfig.build.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build && bun run check:package && bun run accept:node",
    "check:package": "bun package-check.ts && publint --strict && attw --pack . --profile esm-only",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@opentui/solid": "0.5.11",
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "1.82.0",
    "publint": "0.3.24",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opentui/solid": "^0.5.11",
    "solid-js": "1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=26.4.0"
  },
  "packageManager": "bun@1.4.0"
}
